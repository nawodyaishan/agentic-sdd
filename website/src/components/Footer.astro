---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import { maintainer } from '../maintainer.mjs';

// `import.meta.env.BASE_URL` is Astro's configured base (`/` or a project base
// such as `/agentic-sdd/`). Normalizing the trailing slash keeps the internal
// contribution route correct for both a user/organization site and a project
// site without duplicating the manifest's `site`/`base` values here.
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const contributingHref = `${base}contributing/development/`;
---

<section class="maintainer-credit" aria-label="Maintainer credit">
	<p>
		Created and maintained by <a href={maintainer.github}>{maintainer.name}</a>
		<span class="credit-separator" aria-hidden="true">·</span>
		<a href={maintainer.website}>Personal website</a>
		<span class="credit-separator" aria-hidden="true">·</span>
		<a href={contributingHref}>Contributing</a>
	</p>
</section>

<DefaultFooter />

<style>
	.maintainer-credit {
		margin-top: 2rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	.maintainer-credit p {
		margin: 0;
	}

	.maintainer-credit a {
		color: var(--sl-color-text-accent);
		text-underline-offset: 0.15em;
	}

	.maintainer-credit a:hover {
		color: var(--sl-color-white);
	}

	.maintainer-credit a:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
		border-radius: 0.15rem;
	}

	.credit-separator {
		margin-inline: 0.15rem;
	}
</style>
